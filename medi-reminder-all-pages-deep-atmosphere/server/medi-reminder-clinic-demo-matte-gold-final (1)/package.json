{
  "name": "medi-reminder-fullstack",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c blue,green \"npm run dev --workspace=medi-reminder-server\" \"npm run dev --workspace=medi-reminder-client\"",
    "dev:client": "npm run dev --workspace=medi-reminder-client",
    "dev:server": "npm run dev --workspace=medi-reminder-server",
    "build": "npm run build --workspace=medi-reminder-client"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
